{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DemoData": {
    "Enabled": false,
    "Password": ""
  },
  "Security": {
    "CookieSecurePolicy": "Always",
    "LoginPermitLimitPerMinute": 10
