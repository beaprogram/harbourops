{
  "Hosting": {
    "RequireSecureConfiguration": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DemoData": {
    "Enabled": false
  },
  "DemoSandbox": {
    "Enabled": true
  },
  "DataProtection": {
    "ApplicationName": "HarbourOps.PublicDemo"
  },
  "Attachments": {
    "MaxConcurrentProcessing": 1,
    "MaxQueuedUploads": 4,
    "Storage": {
      "Provider": "AzureBlob",
      "AzureBlob": {
        "ContainerName": "demo-photos"
      }
    }
  }
}
