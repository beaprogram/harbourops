# Copy to .env (git-ignored):  cp .env.example .env
# Values here are placeholders or demo-only. Never put real credentials in this file.

# Password for the local Docker PostgreSQL container. Any random string works locally.
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Shared password for the fictional demo accounts. Demo-only and publicly documented in README.md.
DEMO_PASSWORD=HarbourDemo!2026
